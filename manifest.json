{
  "manifest_version": 3,
  "name": "Луна — пиксельный питомец",
  "description": "Пиксельные питомцы для открытых страниц. Выберите Луну или загрузите своего персонажа.",
  "version": "2.4.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Луна",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "atlas.js",
        "pet.js",
        "platforms.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
